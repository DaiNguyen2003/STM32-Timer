# Ignore everything
*

# But not these files/directories (which we want to track)
!.gitignore
!README.md
!docs/
!docs/**
!Core/
!Core/Src/
!Core/Src/main.c
!Core/Inc/
!Core/Inc/main.h
!Digital_Servo.ioc

# Ignore everything else in Core/
Core/Src/*
!Core/Src/main.c
Core/Inc/*
!Core/Inc/main.h

# Standalone firmware and RS485 sources
!build.py
!firmware/
!firmware/**
!Core/Inc/rs485*.h
!Core/Src/rs485*.c
!tools/
!tools/**
!tests/
!tests/**
/build/
__pycache__/
